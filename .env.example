DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Token do Vercel Blob (Storage tab do projeto na Vercel → Create → Blob) — usado pra
# upload de foto de perfil/capa. Sem isso, POST /api/user/avatar e /api/user/cover falham.
BLOB_READ_WRITE_TOKEN=""

# Chave gratuita em https://aistudio.google.com/apikey (modelo gemini-2.5-flash, sem cartão)
GEMINI_API_KEY=""

# String aleatória de 32+ caracteres usada pra selar o cookie de sessão de login.
# Gerada automaticamente em dev pelo nuxt-auth-utils se faltar; em produção precisa
# ser definida explicitamente (senão o app recusa subir).
NUXT_SESSION_PASSWORD=""

# Secret que protege GET /api/cron/daily-closure (fechamento automático de dia via Vercel Cron,
# ver vercel.json). A Vercel envia "Authorization: Bearer $CRON_SECRET" automaticamente quando
# essa env var está setada no projeto. Só necessário em produção; gera com `openssl rand -hex 32`.
CRON_SECRET=""

# Client ID/Secret de OAuth do Google Cloud Console (Web application), usado pra vincular
# a conta Google e ler o Google Classroom. Redirect URI a registrar no Console:
# {origin}/auth/google (não /api/auth/google). Escopos: openid, email,
# classroom.courses.readonly, classroom.coursework.me.readonly.
NUXT_OAUTH_GOOGLE_CLIENT_ID=""
NUXT_OAUTH_GOOGLE_CLIENT_SECRET=""
